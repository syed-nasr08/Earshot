# Copy this file to .env and fill in your key.
OPENROUTER_API_KEY=sk-or-your-key-here

# Answer model (any OpenRouter chat model). Change if this one 404s.
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Local Whisper size: tiny.en (fastest) -> base.en -> small.en -> medium.en (best)
WHISPER_MODEL=small.en

# Microphone: empty = system default. Set to a device index or name substring
# (e.g. MacBook). List options with:  python main.py --list-devices
# INPUT_DEVICE=

# Tuning (optional)
# VAD_AGGRESSIVENESS=2   # 0-3, higher ignores more background noise
# SILENCE_MS=900         # pause length (ms) that marks end of a question
# MIN_SPEECH_MS=400      # ignore noises shorter than this

# --- Google Doc output (optional) -------------------------------------------
# If set, answers go to your Google Doc instead of the local .docx.
# Deploy google_apps_script.gs as a Web App, then paste its /exec URL here.
# GDOC_SECRET must match the SECRET inside that script.
# GDOC_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# GDOC_SECRET=change-me-to-a-secret
